APP_NAME=EduNexus
APP_ENV=development
APP_PORT=8080
# Required: generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_EXPIRE=24h

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=edunexus
DB_SSLMODE=disable
# Email notifications (never commit real credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000

# AI tutor: server-side only; use a model supporting PDF inputs and structured outputs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Device notifications (server keys only)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
FIREBASE_SERVICE_ACCOUNT_FILE=
REALTIME_PUBLIC_URL=
REALTIME_ALLOWED_ORIGINS=
ANDROID_RELEASE_MANIFEST=

# Audio/video calling. Use your public TURN hostname for calls across networks.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_SECRET=
