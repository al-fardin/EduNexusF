{
  "manifest_version": 3,
  "name": "EduNexus Exam Monitor",
  "description": "Consented exam-only: browser domains, search terms, supported AI prompts, selection copies and exam pastes; never historical chats or passwords.",
  "version": "1.3.3",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "ai-evidence.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "EduNexus monitoring status",
    "default_popup": "popup.html"
  }
}
